{
  "name": "zentoviatech",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@zentovia/web",
    "dev:admin": "npm run dev --workspace=@zentovia/admin",
    "dev:backend": "npm run start:dev --workspace=@zentovia/backend",
    "build:web": "npm run build --workspace=@zentovia/web",
    "build:admin": "npm run build --workspace=@zentovia/admin",
    "build:backend": "npm run build --workspace=@zentovia/backend"
  }
}